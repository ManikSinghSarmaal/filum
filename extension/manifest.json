{
  "manifest_version": 3,
  "name": "Filum — Web Journey",
  "version": "1.0.0",
  "description": "Pin browsing trails to your Filum threads.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation", "history"],
  "host_permissions": ["http://localhost:4317/*", "http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Filum — Web Journey",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/filum-16.png", "32": "icons/filum-32.png", "48": "icons/filum-48.png" }
  },
  "icons": { "16": "icons/filum-16.png", "32": "icons/filum-32.png", "48": "icons/filum-48.png", "128": "icons/filum-128.png" }
}
